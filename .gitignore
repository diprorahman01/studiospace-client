
# ========================================
# StudioSpace - Client Git Ignore
# ========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/playwright-report/
/test-results/

# Next.js
/.next/
/out/

# Production Builds
/build
/dist

# Environment Variables
.env
.env.*
!.env.example

# Vercel
.vercel/

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Sensitive Files
*.pem
*.key
*.p12
*.pfx

# Temporary Files
*.tmp
*.temp
.cache/

# Local Backup Files
*.bak
*.backup
